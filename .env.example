# Copy to .env and edit before running. .env is git-ignored.

# Application
APP_ENV=development
HTTP_ADDR=:8080
TARGET_PATH=./p1/demo

# Neo4j — on the host dev workflow, bolt://localhost:7687.
# docker-compose overrides NEO4J_URI to bolt://neo4j:7687 for the containerised app.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
